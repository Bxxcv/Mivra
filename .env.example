# Supabase — ambil dari Project Settings > API di dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HANYA untuk server (Route Handler/Server Action) — JANGAN pernah pakai
# prefix NEXT_PUBLIC_, dan JANGAN commit nilai aslinya ke Git.
SUPABASE_SERVICE_ROLE_KEY=

# Domain production — isi setelah domain custom dibeli lewat Vercel.
# Sebelum itu, boleh dikosongkan (fallback otomatis ke URL preview Vercel).
NEXT_PUBLIC_SITE_URL=

# Payment gateway — menyusul di Fase 8 (lihat docs/ROADMAP.md), masih kosong.
